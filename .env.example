# =============================================================================
# GreenVolt Electronics — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / API
# -----------------------------------------------------------------------------
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins for the API (strict CORS).
BACKEND_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL for dev; models are MySQL-compatible)
# -----------------------------------------------------------------------------
POSTGRES_USER=greenvolt
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=greenvolt
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full async connection URL. compose overrides host to `db`; local dev uses localhost.
DATABASE_URL=postgresql+psycopg://greenvolt:change-me-in-production@db:5432/greenvolt

# -----------------------------------------------------------------------------
# Auth / security
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
# Set true behind HTTPS (sets Secure cookies + HSTS).
COOKIE_SECURE=false
ENABLE_HSTS=false
# Cookie domain (leave blank for localhost).
COOKIE_DOMAIN=
CSRF_COOKIE_NAME=gv_csrf
CSRF_HEADER_NAME=x-csrf-token

# Feature flags (shared by API; the web uses its own NEXT_PUBLIC_* mirror below)
ENABLE_USER_AUTH=false
ENABLE_AI=false
# Public base URL for building links in emails / canonical URLs.
PUBLIC_SITE_URL=http://localhost:3000
# Browser API base (relative => goes through the Next.js proxy, same-origin).
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Where the Next.js proxy forwards /api/v1/* (docker: http://api:8000).
API_PROXY_TARGET=http://localhost:8000
# Where server components fetch the API directly (docker: http://api:8000/api/v1).
API_INTERNAL_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# Seed admin (used by `python -m app.seed`; never hardcode in source)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@greenvolt.example
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=GreenVolt Owner

# -----------------------------------------------------------------------------
# Email / SMTP (FastAPI background tasks)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=GreenVolt Electronics <no-reply@greenvolt.example>
# Where inquiry notifications are delivered.
MAIL_OWNER=info@greenvolt.example
# When true, emails are logged instead of sent (useful for dev/tests).
MAIL_SUPPRESS_SEND=true

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
CONTACT_RATE_LIMIT=5/minute
LOGIN_RATE_LIMIT=10/minute

# -----------------------------------------------------------------------------
# Uploads (admin media library)
# -----------------------------------------------------------------------------
# Directory (relative to the API working dir) where uploaded images are stored.
MEDIA_ROOT=media/uploads
# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=5

# -----------------------------------------------------------------------------
# AI (optional, feature-flagged; server-side only)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Web (Next.js) — public runtime config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=GreenVolt Electronics
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=923365447805
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/greenvolt
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/greenvolt
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@greenvolt
NEXT_PUBLIC_ENABLE_USER_AUTH=false
# Web mirror of ENABLE_AI (shows/hides the AI buttons in the blog editor).
NEXT_PUBLIC_ENABLE_AI=false
